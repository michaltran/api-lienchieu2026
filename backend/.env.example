# ==================== Server ====================
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000

# ==================== PostgreSQL ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lienchieu_db
DB_USER=postgres
DB_PASSWORD=your_password_here
# Nếu dùng connection string (Supabase/Neon/Railway):
# DATABASE_URL=postgresql://user:pass@host:5432/db

# ==================== JWT ====================
JWT_SECRET=change_this_to_a_random_32_char_string_xxxxxxxxxx
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change_this_to_another_random_32_char_string_xxxxx
JWT_REFRESH_EXPIRES_IN=7d

# ==================== CORS ====================
ADMIN_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ==================== Cloudinary ====================
# Đăng ký free tại https://cloudinary.com (25GB/tháng miễn phí)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=lienchieu

# ==================== Tài khoản admin mặc định ====================
# (chỉ dùng khi chạy lệnh npm run db:seed)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@lienchieu.gov.vn
DEFAULT_ADMIN_PASSWORD=Admin@123456

# ==================== Upload limits ====================
MAX_IMAGE_SIZE=10485760
MAX_VIDEO_SIZE=104857600
